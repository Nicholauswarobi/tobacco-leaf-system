APP_NAME="Tobacco Leaf API"
APP_VERSION="1.0.0"
DEBUG=true

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Paths
UPLOAD_DIR=uploads
MODEL_DIR=saved_models
DISEASE_MODEL_PATH=saved_models/tobacco_disease_model.keras
QUALITY_MODEL_PATH=saved_models/tobacco_quality_model.keras
VERIFICATION_MODEL_PATH=saved_models/tobacco_verification_model.keras
VERIFICATION_METADATA_PATH=saved_models/verification_metadata.json

# Tobacco verification gate — runs before disease detection and quality grading.
# Disabling it lets non-tobacco images reach models that cannot handle them.
VERIFICATION_ENABLED=true
# Minimum P(Tobacco) needed to continue. Ignored when verification_metadata.json
# is present, since that file carries the threshold calibrated during training.
VERIFICATION_THRESHOLD=0.5
# Use the HSV colour pre-screen while the verification model is untrained.
VERIFICATION_COLOR_FALLBACK=true

# Image preprocessing
IMAGE_SIZE=224
MAX_UPLOAD_MB=10

# History DB
HISTORY_DB=history.db

# CHANGE THIS in production!
ADMIN_API_KEY=change-me-in-production
